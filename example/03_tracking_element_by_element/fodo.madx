TITLE, "FODO";
OPTION, -echo;

print, TEXT = "parameters of proton, 2TeV";
BEAM, MASS = PMASS, ENERGY = PMASS + 2000, CHARGE = 1;

N_dipole = 40;
THB = 2*pi/N_dipole;

LB = 2.86;
Lquad = 1.0;
Lsext = 0.2;

RHO = LB/THB;

value, THB;
value, RHO;
value, BEAM->BRHO/RHO;

ES: MARKER;
SR: MARKER;


!------------------------------ Arc section ------------------------------!

MB: SBEND, L = LB, ANGLE = THB, E1 = 0.5*THB, E2 = 0.5*THB, FINT = 0.489, FINTX = -1, HGAP = 0.052;
! MB: SBEND, L = LB, ANGLE = THB, E1 = 0.0*THB, E2 = 0.0*THB, FINT = 0.489, FINTX = 0.489, HGAP = 0.052;

QF1: QUADRUPOLE, L = Lquad, K1 := +0.2;
QD1: QUADRUPOLE, L = Lquad, K1 := -0.2;

DR1: DRIFT, L = 0.1;
DR2_MB: DRIFT, L = LB;
DR3_GAP: DRIFT, L = 0.9;
DR4_GAP: DRIFT, L = 0.5;

SF1: SEXTUPOLE, L = 0.4, K2 := 0.0;
SD1: SEXTUPOLE, L = 0.4, K2 := 0.0;

OF1: OCTUPOLE, L = 0.1, K3 := 1000.0;
OD1: OCTUPOLE, L = 0.1, K3 := -1000.0;

M1_ARC1: MARKER;
M2_ARC1: MARKER;
M3_ARC1: MARKER;
M4_ARC1: MARKER;

SEQ_ARC1: LINE = (
    QF1, 3*DR1, SF1, 3*DR1, MB, 10*DR1, QD1, 3*DR1, SD1, 3*DR1, MB, 10*DR1
);
SEQ_ARC2: LINE = (
    QF1, 1*DR1, OF1, 1*DR1, SF1, 3*DR1, MB, 10*DR1, QD1, 1*DR1, OD1, 1*DR1, SD1, 3*DR1, MB, 10*DR1
);

USE, SEQUENCE = SEQ_ARC1;

MATCH, SEQUENCE = SEQ_ARC1;
MATCH, SEQUENCE = SEQ_ARC1;
    VARY, NAME = QF1->K1, STEP = 1.0E-8;
    VARY, NAME = QD1->K1, STEP = 1.0E-8;
    ! VARY, NAME = QF2_ARC1->K1, STEP = 1.0E-8;

    CONSTRAINT, SEQUENCE = SEQ_ARC1, RANGE = #E, MUX = 0.1735;
    CONSTRAINT, SEQUENCE = SEQ_ARC1, RANGE = #E, MUY = 0.1715;
    ! CONSTRAINT, SEQUENCE = SEQ_ARC1, RANGE = M1_ARC1, DX = 0;

    LMDIF, CALLS = 1000000, TOLERANCE = 1E-10;
ENDMATCH;

SAVEBETA, LABEL = TWISS_ARC1_END, PLACE = #E, SEQUENCE = SEQ_ARC1;

SELECT, FLAG=TWISS, COLUMN=NAME,KEYWORD,S,L,BETX,ALFX,MUX,BETY,ALFY,MUY,X,Y,DX,DPX,ANGLE,K0L,K1L,K2L,K3L,E1,E2,H1,H2,HGAP,FINT,FINTX;
! TWISS, BETA0 = TWISS_ARC1_START, FILE = FODO_ARC1.dat;
! TWISS, FILE = FODO_ARC1.tfs;

RING: LINE = (20*SEQ_ARC1);
! RING: LINE = (19*SEQ_ARC1, 1*SEQ_ARC2);
USE, SEQUENCE = RING;


MATCH,SEQUENCE=RING,CHROM;
! MATCH,SEQUENCE=RING;
VARY, NAME = SF1->K2;
VARY, NAME = SD1->K2;
GLOBAL, SEQUENCE = RING, DQ1 = -1, DQ2 = -1;
LMDIF, CALLS = 20000;
JACOBIAN, CALLS = 1000, TOLERANCE = 1.0E-12;
ENDMATCH;


TWISS, CHROM, FILE = fodo.tfs;

PLOT, HAXIS=S, VAXIS1=BETX, BETY, VAXIS2 = DX, COLOUR=100, TITLE='FODO', FILE=FODO;
PLOT, HAXIS=S, VAXIS1=DX, DPX, COLOUR=100, TITLE='FODO', FILE=FODO;
PLOT, HAXIS=S, VAXIS1=MUX, MUY, COLOUR=100, TITLE='FODO', FILE=FODO;

PTC_CREATE_UNIVERSE;
PTC_CREATE_LAYOUT, MODEL=1, METHOD=4, NST=5, EXACT;
SELECT, FLAG=ptc_twiss, CLEAR;
SELECT, FLAG=ptc_twiss, COLUMN=NAME,KEYWORD,S,L,BETX,ALFX,MUX,BETY,ALFY,MUY,X,Y,DX,DPX,ANGLE,K0L,K1L,K2L,K3L,E1,E2,H1,H2,HGAP,FINT,FINTX;
PTC_TWISS, ICASE=5, NO=2, file = fodo_ptc.tfs;
PTC_END;

SAVE, BEAM, SEQUENCE = RING, FILE = FODO.seq;
